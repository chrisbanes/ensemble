        {
          "type": "text",
          "id": "JwiRg",
          "name": "Overview, project and cross-project List/Board, Inbox, and direct task links retain task/project/source identity. Returning restores the origin; direct entry uses the project as fallback. Context menus and notifications are not added by this change.",
          "fill": "$X:--foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Desktop sidebar Search and phone header Search open shared recorded-work search. Search is active while searching or inspecting a match. Overview, project/cross-project List/Board and Inbox keep their origin anchors. Search return restores query, project/type/date/history filters, selection and position. Direct task links fall back to project; no new notification, menu or extension surface.",
          "lineHeight": 1.4,
          "fontFamily": "$font-sans",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
