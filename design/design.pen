              "children": [
                {
                  "type": "text",
                  "id": "aD2YK",
                  "name": "Validation, focus & submission title",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Validation, focus & submission",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "AY2tt",
                  "name": "Validation, focus & submission details",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tab reaches each question and the fixed submit control. Arrow keys move within radio options; Space selects a radio or checkbox. Focus has a visible blue/dark outline. Errors sit beside their question and submission focuses the first invalid field. If Q2 exceeds two choices: “Select no more than 2 sections.” Submit the related answers together; suggestions never auto-submit.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "IWrOu",
              "name": "Board navigation & state",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "zOSpX",
                  "name": "Board navigation & state title",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Board navigation & state",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "ROglW",
                  "name": "Board navigation & state details",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "List and Board share project/task filters and the exact same task IDs. Switching changes presentation only. Preserve selected task and restore each view’s scroll position. Each column scrolls vertically; use the named column tabs for horizontal navigation. Phone shows one column at a time with 44px tabs and previous/next controls.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "iyhaK",
          "name": "Board boundary and discoverability",
          "fill": "$X:--muted-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Board cards open the existing task detail; Enter activates the focused card. Return restores filters, column and scroll. Stopping and Uncertain remain named tabs with counts, plus the persistent attention summary and Inbox link. States use words as well as colour. Columns are Ensemble work states, never GitHub issue state or Project fields. No dragging, arbitrary state changes or GitHub writes are offered.",
