                {
                  "type": "text",
                  "id": "T2w5Km",
                  "name": "Question navigation & persistence details",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Inbox selection, filters, reading position, unfinished text and option selections stay anchored as updates arrive. Task history keeps its expanded groups. Unresolved requests stay above collapsed history. Back restores the originating Inbox selection. Phone examples show two scroll positions of one form, not separate submissions.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "c1Bcrp",
              "name": "Validation, focus & submission",
              "width": "fill_container",
