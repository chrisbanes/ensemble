                {
                  "type": "text",
                  "id": "ROglW",
                  "name": "Board navigation & state details",
                  "fill": "$X:--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "List and Board share project/task filters and the exact same task IDs. Switching changes presentation only. Preserve selected task and restore each view’s scroll position. Each column scrolls vertically; use the named column tabs for horizontal navigation. Phone shows one column at a time with 44px tabs and previous/next controls.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "iyhaK",
          "name": "Board boundary and discoverability",
          "fill": "$X:--muted-foreground",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Board cards open the existing task detail; Enter activates the focused card. Return restores filters, column and scroll. Stopping and Uncertain remain named tabs with counts, plus the persistent attention summary and Inbox link. States use words as well as colour. Columns are Ensemble work states, never GitHub issue state or Project fields. No dragging, arbitrary state changes or GitHub writes are offered.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "z88kB8",
