{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "service": "node dist/src/standalone/cli.js",
    "operations": "node dist/src/standalone/operations-cli.js",
    "operator-auth": "npm run build && node dist/src/standalone/operator-auth-cli.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "s04b:view": "node test/s04b/local-view.mjs",
    "s04b:live": "node test/s04b/live-runtime.mjs --live",
    "s04d:live": "node test/s04d/live-operator.mjs --live",
    "s03b:live": "node test/s03b/live-runtime.mjs --live",
    "s08a:live": "node test/s08a/live-operations.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
