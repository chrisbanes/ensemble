{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.1",
  "bin": {
    "ensemble": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "dist/operator"
  ],
  "scripts": {
    "service": "node dist/src/standalone/cli.js",
    "operations": "node dist/src/standalone/operations-cli.js",
    "operator-auth": "npm run build && node dist/src/standalone/operator-auth-cli.js",
    "build": "npm run build:service && npm run build:web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run build && npm run test:built",
    "test:fixture-preflight": "npm run build && node scripts/run-tests.mjs --fixture-preflight",
    "routing:view": "node test/coordination/routing-qualification/local-view.mjs",
    "routing:live": "node test/coordination/routing-qualification/live-runtime.mjs --live",
    "operator:live": "node test/operator/integration-qualification/live-operator.mjs --live",
    "diagnostics:live": "node test/operator/diagnostics-qualification/live-diagnostics.mjs --live --one-attempt",
    "codex-settings:live": "node test/operator/diagnostics-qualification/live-diagnostics.mjs --codex-settings --live --one-attempt",
    "operator-cli:live": "node test/operator/cli-journey-qualification/live-journey.mjs --live --max-turns 2",
    "mixed-runtime:live": "node test/execution/mixed-runtime-qualification/live-journeys.mjs",
    "coordination:live": "node test/coordination/live-qualification/live-journey.mjs",
    "coordination:routing:live": "node test/coordination/live-qualification/live-routing.mjs",
    "status-mapping:live": "node test/delivery/github-qualification/live-status-mapping.mjs",
    "task-publication:live": "node test/delivery/github-qualification/live-task-publication.mjs",
    "network-access:live": "node test/execution/network-access-qualification/live-network.mjs --live --one-attempt",
    "drafting:live": "node test/execution/drafting-qualification/live-drafting.mjs",
    "recovery:live": "node test/execution/recovery-qualification/live-runtime.mjs --live",
    "operations:live": "node test/operations/live-qualification/live-operations.mjs",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:service": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "native-input:live": "node test/execution/native-input-qualification/runtime-contract.mjs --live --phase service",
    "test:built": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@typesafe-ai/sdk": "0.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
