{
  "openapi": "3.1.0",
  "info": {
    "title": "Ensemble API",
    "description": "Ensemble orchestrator REST API for inspecting and controlling agent runs.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "GET /api/v1/config",
        "description": "Returns the effective ensemble configuration and validation state.",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Effective configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "tags": [
          "history"
        ],
        "summary": "GET /api/v1/history",
        "description": "Returns paginated history records with optional filtering by outcome or step.",
        "operationId": "getHistory",
        "parameters": [
          {
            "name": "outcome",
            "in": "query",
            "description": "Filter to records with this outcome (e.g. \"succeeded\", \"failed\").",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "step",
            "in": "query",
            "description": "Filter to records that traversed a specific step name.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor-based pagination: skip records before this 0-based index.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of records to return (default: 50).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Read error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refresh": {
      "post": {
        "tags": [
          "controls"
        ],
        "summary": "POST /api/v1/refresh",
        "description": "Signals the orchestrator to run an immediate tick (poll + reconcile).\nReturns 202 Accepted with a confirmation body.",
        "operationId": "postRefresh",
        "responses": {
          "202": {
            "description": "Refresh queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "tags": [
          "state"
        ],
        "summary": "GET /api/v1/state",
        "description": "Acquires a read lock on the orchestrator state, builds a RuntimeSnapshot,\nand returns it as JSON.",
        "operationId": "getState",
        "responses": {
          "200": {
            "description": "Runtime snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{identifier}": {
      "get": {
        "tags": [
          "issues"
        ],
        "summary": "GET /api/v1/{identifier}",
        "description": "Looks up an issue by its identifier (e.g. \"my-repo#42\") in running and retry maps.\nReturns the issue detail or 404 with a JSON error envelope.",
        "operationId": "getIssueDetail",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Issue identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Issue detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDetailSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Issue not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{identifier}/conversation": {
      "get": {
        "tags": [
          "conversation"
        ],
        "summary": "GET /api/v1/{identifier}/conversation",
        "description": "Returns paginated conversation messages from the workspace's conversation.jsonl file.",
        "operationId": "getConversation",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Issue identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor-based pagination: skip messages before this 0-based index.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of messages to return (default: 50).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{identifier}/conversation/{index}": {
      "get": {
        "tags": [
          "conversation"
        ],
        "summary": "GET /api/v1/{identifier}/conversation/{index}",
        "description": "Returns a single conversation message by its index.",
        "operationId": "getConversationMessage",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Issue identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "Message index",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationMessage"
                }
              }
            }
          },
          "404": {
            "description": "Message not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{identifier}/retry": {
      "post": {
        "tags": [
          "controls"
        ],
        "summary": "POST /api/v1/{identifier}/retry",
        "description": "Removes an issue from the retry queue, making it available for immediate re-dispatch.\nReturns 404 if not found, 409 if the issue is currently running (not retrying).",
        "operationId": "postRetry",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Issue identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retry queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Not retrying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{identifier}/stop": {
      "post": {
        "tags": [
          "controls"
        ],
        "summary": "POST /api/v1/{identifier}/stop",
        "description": "Stops a running agent for the specified issue. Sends SIGTERM to the agent process\nand removes it from the running state. Returns 404 if not found, 409 if not running.",
        "operationId": "postStop",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "Issue identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent stopped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Not running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentConfig": {
        "type": "object",
        "description": "Per-agent definition: which executor to use and what prompt to send.",
        "required": [
          "executor",
          "model"
        ],
        "properties": {
          "executor": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_template": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AgentRuntimeConfig": {
        "type": "object",
        "description": "Runtime configuration for the agent executor.",
        "properties": {
          "command": {
            "type": "string"
          },
          "max_retry_backoff_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_turns": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "permission_policy": {
            "type": "string"
          },
          "read_timeout_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "session_mode": {
            "type": "string"
          },
          "stall_timeout_ms": {
            "type": "integer",
            "format": "int64"
          },
          "turn_timeout_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AgentTotalsSnapshot": {
        "type": "object",
        "description": "Aggregate token and runtime totals for the snapshot.",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "seconds_running"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "seconds_running": {
            "type": "number",
            "format": "double"
          },
          "total_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "Standard JSON error envelope matching SPEC.md Section 13.7.2 error format.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        }
      },
      "ApiErrorDetail": {
        "type": "object",
        "description": "Inner detail of the error envelope.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AttemptInfo": {
        "type": "object",
        "description": "Attempt tracking for issue detail.",
        "required": [
          "restart_count"
        ],
        "properties": {
          "current_retry_attempt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "restart_count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ConcurrencyConfig": {
        "type": "object",
        "description": "Concurrency limits for the pipeline orchestrator.",
        "properties": {
          "max_concurrent_agents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_step_parallelism": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ConfigResponse": {
        "type": "object",
        "description": "Response for GET /api/v1/config.",
        "required": [
          "valid",
          "errors",
          "config_path",
          "config"
        ],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/EnsembleConfig"
          },
          "config_path": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      },
      "ConversationMessage": {
        "type": "object",
        "description": "A single conversation message.",
        "required": [
          "index",
          "role",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "role": {
            "type": "string"
          },
          "tool_calls": {},
          "tool_output": {}
        }
      },
      "ConversationResponse": {
        "type": "object",
        "description": "Response envelope for conversation queries.",
        "required": [
          "messages",
          "total"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "EnsembleConfig": {
        "type": "object",
        "description": "Top-level configuration parsed from `ensemble.yaml`.",
        "required": [
          "tracker",
          "agents",
          "steps",
          "on_success",
          "on_failure"
        ],
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentRuntimeConfig"
          },
          "agents": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AgentConfig"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "concurrency": {
            "$ref": "#/components/schemas/ConcurrencyConfig"
          },
          "hooks": {
            "$ref": "#/components/schemas/HooksConfig"
          },
          "max_cycles": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "on_failure": {
            "type": "string"
          },
          "on_success": {
            "type": "string"
          },
          "polling": {
            "$ref": "#/components/schemas/PollingConfig"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepConfig"
            }
          },
          "tracker": {
            "$ref": "#/components/schemas/TrackerConfig"
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceConfig"
          }
        }
      },
      "HistoryRecord": {
        "type": "object",
        "required": [
          "issue_identifier",
          "issue_id",
          "outcome",
          "steps_traversed",
          "attempts",
          "tokens",
          "duration_seconds",
          "started_at",
          "completed_at",
          "workspace_path"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "issue_id": {
            "type": "string"
          },
          "issue_identifier": {
            "type": "string"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "steps_traversed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenTotals"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_path": {
            "type": "string"
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "description": "Response envelope for history queries.",
        "required": [
          "records",
          "total"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryRecord"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "HooksConfig": {
        "type": "object",
        "description": "Shell hooks run at lifecycle events in each workspace.",
        "properties": {
          "after_create": {
            "type": [
              "string",
              "null"
            ]
          },
          "after_run": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_remove": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_run": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "IssueDetailSnapshot": {
        "type": "object",
        "description": "Per-issue detail snapshot for GET /api/v1/{identifier}.\n\nNOTE: Plan 5 (Dashboard) expects additional fields `logs` and `recent_events`\nin the API response. When implementing the dashboard integration, extend this\nstruct with `logs` and `recent_events` fields.\nThese are omitted here because Plan 4 does not yet have the event/log collection\ninfrastructure, but the JSON shape should be forward-compatible.",
        "required": [
          "issue_identifier",
          "issue_id",
          "status",
          "workspace",
          "attempts"
        ],
        "properties": {
          "attempts": {
            "$ref": "#/components/schemas/AttemptInfo"
          },
          "issue_id": {
            "type": "string"
          },
          "issue_identifier": {
            "type": "string"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "retry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RetryRow"
              }
            ]
          },
          "running": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RunningDetail"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceInfo"
          }
        }
      },
      "PollingConfig": {
        "type": "object",
        "description": "How often to poll the tracker for new issues.",
        "properties": {
          "interval_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "RateLimitSnapshot": {
        "type": "object",
        "description": "Rate limit snapshot from agent events.",
        "properties": {
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "remaining": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "reset_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "description": "Response body for POST /api/v1/refresh.",
        "required": [
          "queued",
          "coalesced",
          "requested_at",
          "operations"
        ],
        "properties": {
          "coalesced": {
            "type": "boolean"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "queued": {
            "type": "boolean"
          },
          "requested_at": {
            "type": "string"
          }
        }
      },
      "RetryResponse": {
        "type": "object",
        "description": "Response for a successful retry operation.",
        "required": [
          "retried",
          "issue_identifier",
          "message"
        ],
        "properties": {
          "issue_identifier": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retried": {
            "type": "boolean"
          }
        }
      },
      "RetryRow": {
        "type": "object",
        "description": "A single row in the retry queue list.",
        "required": [
          "issue_id",
          "issue_identifier",
          "attempt",
          "due_at_ms"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "due_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue_id": {
            "type": "string"
          },
          "issue_identifier": {
            "type": "string"
          }
        }
      },
      "RunningDetail": {
        "type": "object",
        "description": "Running session detail for issue detail.",
        "required": [
          "turn_count",
          "state",
          "started_at",
          "tokens"
        ],
        "properties": {
          "last_event": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_event_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
