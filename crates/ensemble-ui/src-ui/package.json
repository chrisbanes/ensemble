{
  "name": "ensemble-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm run codegen && vite",
    "build": "pnpm run codegen && tsc && vite build",
    "build:embed": "pnpm run codegen:client && tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "codegen:spec": "cd ../../../ && cargo test -p ensemble-core --test openapi_spec write_openapi_spec -- --ignored",
    "codegen:client": "orval",
    "codegen": "pnpm run codegen:spec && pnpm run codegen:client"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "orval": "^8.26.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
