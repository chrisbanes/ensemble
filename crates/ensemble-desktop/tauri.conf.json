{
  "productName": "Ensemble",
  "version": "0.0.1",
  "identifier": "com.ensemble.dashboard",
  "build": {
    "frontendDist": "../ensemble-ui/src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --prefix ../ensemble-ui/src-ui run dev",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "app": {
    "windows": []
  }
}
